<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
</head>
<body>
    <h1>This is update password page</h1>
    <!-- <p> <%= token  %> </p> -->
    <input type="password"  id="passwordInput">
    <button onclick="handleSubmit()">submit</button>

    <script>
        let token = '<%= token %>'
        console.log(token)

        let passwordtag = document.getElementById('passwordInput')

        async function handleSubmit(){
            let obj = {
                password:passwordtag.value
            }

            let res = await fetch(`http://localhost:8090/users/updatePassword/${token}`,{
                method:"POST",
                headers:{
                    'content-type':'application/json'
                },
                body:JSON.stringify(obj)
            })

            let data = await res.json();
            console.log(data)
        }

    </script>
</body>
</html>